# Rust（Cargo.lock 必须入库：二进制 workspace 官方建议；否则 CI 缓存 key
# hashFiles('**/Cargo.lock') 恒空、构建不可复现、cargo audit 扫描漂移）
target/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build
release/
*.tar.gz
*.zip

# Logs
*.log

# Temporary
tmp/
temp/
.e2e/

# 节点证书与私钥（切勿提交到仓库）
hydra-node-cert.der
hydra-node-key.der
*.der
*.pem
# 探测/测试密钥（.probe/ 为本地 TLS 探测工件，含认证密钥）
*.hex
.probe/

# ZCode 本地会话产物（计划/缓存，与仓库交付无关）
.zcode/
reg.log
android/scripts/android/
android/app/build/
hydra-android-m1-debug.apk
*.apk
# Android 原生库是构建产物（cargo-ndk 产出，不入库）
*.so
android/.gradle/
*.tmp
