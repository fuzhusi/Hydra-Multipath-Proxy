# Hydra 节点 systemd 服务单元
# 安装（deploy/install.sh 自动完成）:
#   sudo cp deploy/hydra-node.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hydra-node

[Unit]
Description=Hydra Multipath Proxy Node (QUIC/UDP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── 证书 CWD 陷阱修复（部署评估坑③）──────────────────────────────
# hydra-node 默认把自签证书/私钥写到「进程当前工作目录」（相对路径）。
# 若不设 WorkingDirectory，systemd 默认从 / 启动 → 证书重新生成到
# /hydra-node-cert.der → 客户端 pin 的旧证书全部失配，全员断连且日志
# 无明显线索。固定 WorkingDirectory 后证书稳定落在 /etc/hydra/。
WorkingDirectory=/etc/hydra

# ── 密钥经 EnvironmentFile 注入（部署评估坑⑤缓解）────────────────
# /etc/hydra/env 权限 600、属主 hydra，不进 shell history、不进 cmdline、
# 不出现在 unit 文件里（unit 是 world-readable 的）
EnvironmentFile=/etc/hydra/env
ExecStart=/usr/local/bin/hydra-node

# 崩溃/被杀自动拉起
Restart=always
RestartSec=3s

# ── 专用非 root 用户 + 绑 443（部署评估坑①）──────────────────────
# install.sh 创建系统用户 hydra；CAP_NET_BIND_SERVICE 允许非 root 绑定 443，
# 无需 root 运行、无需 setcap
User=hydra
Group=hydra
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# ── 加固：全文件系统只读，仅 /etc/hydra 可写（写证书/私钥）────────
ProtectSystem=strict
ReadWritePaths=/etc/hydra
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
