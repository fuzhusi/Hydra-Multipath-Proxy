<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M1 进程内 SOCKS：应用自身出站访问节点 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- M1 前台服务保活（防 Cached App Freezer 冻结后台引擎）；M2 换 VpnService 常驻 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 分享链接深链：聊天工具/浏览器点开 hydra:// 直达导入 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hydra" />
            </intent-filter>
        </activity>

        <!-- M1：前台服务持有引擎（启停经 Intent action；不对外导出） -->
        <service
            android:name=".EngineService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- M2：全局 VPN（VpnService；系统要求 BIND_VPN_SERVICE 权限声明） -->
        <service
            android:name=".HydraVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- M2：VpnService 声明（engine 服务 + always-on）随 M2 加入 -->
    </application>
</manifest>
