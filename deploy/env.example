# ══════════════════════════════════════════════════════════════════
# Hydra 节点环境变量模板
# 用法: 复制为 /etc/hydra/env（install.sh 自动完成），权限必须是 600
# 修改后: sudo systemctl restart hydra-node
# 与代码现状核对基线: hydra-node/src/config.rs + server.rs + tcp_server.rs
# ══════════════════════════════════════════════════════════════════

# ── 必填: 预共享认证密钥（hex，解码后恰好 32 字节；两端必须一致）──
# 生成: openssl rand -hex 32
#
# ⚠ 密钥安全警告（部署评估坑②）:
#   1. 不要用 `export HYDRA_AUTH_KEY=...` 在 shell 里设置——命令原文会
#      进入 shell history（~/.bash_history），密钥长期留盘；
#   2. 不要用 `--auth-key` 命令行参数——已移除（会进 /proc/<pid>/cmdline，
#      同机所有用户可读）；
#   3. systemd 的 `Environment=` 行也是 world-readable。
#   推荐做法: 用 vi 直接编辑本文件（root:600），systemd 经 EnvironmentFile
#   以 root 读取后注入进程，不落 history、不落 cmdline。
HYDRA_AUTH_KEY=CHANGE_ME__openssl_rand_hex_32

# ── 监听地址（默认 0.0.0.0:8080；公网节点推荐 0.0.0.0:443）────────
# 绑定 443 无需 root: unit 已授予 CAP_NET_BIND_SERVICE
HYDRA_LISTEN=0.0.0.0:443

# ── 传输：TCP/TLS（TLS 1.3 + Noise-PSK），TCP 转型后唯一传输 ──────
# 流量形态 = 标准 HTTPS；无需（也无法）配置传输模式。
# HYDRA_MODE / HYDRA_OBFS_KEY 等 QUIC 时代变量已随 QUIC/UDP 路径移除，写了会被忽略。

# ── 转发空闲超时（秒；默认 300）──────────────────────────────────
# 双向均无数据达此时长即静默双向关闭，防空闲连接耗尽连接额度。
#HYDRA_IDLE_TIMEOUT_SECS=300

# ── P2P 信令模式（NAT 穿透 v1；默认关闭）────────────────────────
# =1 开启节点信令通道，协调两端客户端的 TCP 同时打开打洞；失败自动回落
# 本节点中继。纯中继部署无需开启。
#HYDRA_P2P_SIGNAL=1

# ── 反代静态页回退（抗主动探测；默认 0 关闭，保守升级）──────────
# =1 时，TLS 建立后的认证失败路径（版本字节错误/握手失败/地址帧失步）
# 回复一份内置静态网页而非静默关流——标准反代行为。
# ⚠ 权衡：回退页提升"看起来像真网站"的相似度，但"每次都同一页面"也可被
#   批量探测统计；静默关流则"有 TLS 却永不出字节"本身是指纹。真证书部署
#   建议开启；自签无域名隐蔽部署建议保持关闭。详见 README 部署指南。
#HYDRA_FALLBACK_PAGE=1

# ── 健康检查端点（可选；未设置 = 关闭）──────────────────────────
# GET http://<addr>/health → 200 + JSON，供拨测/负载均衡探活。
# 只绑本机回环，切勿绑 0.0.0.0（避免额外暴露面）。
HYDRA_HEALTH_ADDR=127.0.0.1:8081

# ── 可选: 认证密钥文件（替代 HYDRA_AUTH_KEY env，减小泄漏面）────
# 文件内容为 hex 密钥（解码后恰好 32 字节），权限必须 chmod 600（否则启动告警）。
# 优先级: HYDRA_AUTH_KEY > HYDRA_AUTH_KEY_FILE > 配置文件 auth_key_file 字段。
#HYDRA_AUTH_KEY_FILE=/etc/hydra/auth.key

# ── 可选: 证书/私钥路径（默认相对 CWD）──────────────────────────
# systemd unit 已设 WorkingDirectory=/etc/hydra，故默认即
# /etc/hydra/hydra-node-cert.der / /etc/hydra/hydra-node-key.der，
# 通常无需修改；自签证书首次启动自动生成并持久化（升级/重启不换证书）。
# 真证书部署: 两者指向 ACME 的 PEM fullchain / key（自动识别 PEM/DER）。
#HYDRA_CERT_FILE=/etc/hydra/hydra-node-cert.der
#HYDRA_KEY_FILE=/etc/hydra/hydra-node-key.der

# ── 可选: 其他参数（默认值见 hydra-node --help）─────────────────
# 自签证书 SAN，逗号分隔（真证书部署无需）
#HYDRA_CERT_DOMAINS=hydra.node,localhost
# 最大并发连接数（默认 1000，Semaphore 强制）
#HYDRA_MAX_CONNECTIONS=1000
# 日志级别（默认 info；RUST_LOG 存在时优先）
#HYDRA_LOG_LEVEL=info
# 节点 toml 配置文件路径（自动探测 ./node.toml → /etc/hydra/node.toml）
#HYDRA_NODE_CONFIG=/etc/hydra/node.toml
# 放行私有目标（默认拒绝 SSRF 目标；仅测试/本地开发用，生产切勿开启）
#HYDRA_ALLOW_PRIVATE_TARGETS=1
# ── 可选: 连接年龄上限（秒；默认 0 = 关闭）────────────────────────
# 单条连接存活超过该秒数后由节点主动关闭（长连接周期轮换）。
# clamp 60..=604800，0 表示不限制。
#HYDRA_MAX_CONN_AGE_SECS=0
# ── 可选: 单 IP 并发连接上限（默认 0 = 关闭）────────────────────
# 同一源 IP 的并发连接数硬上限，防单点滥用耗尽全局连接额度；0 = 不限。
#HYDRA_PER_IP_CONNECTIONS=0
# ── 已弃用: HYDRA_AUTH_MODE ────────────────────────────────────
# TCP 转型后仅 v3（TLS+Noise-PSK）生效，该变量已无效——设置了会被忽略。
